# ChangeRadar backend environment
# Copy to `.env` and adjust local values. Never commit `.env`.
# Every variable read by the API/Worker is listed here (ARCHITECTURE §17).

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────
# Host port for the compose PostgreSQL container (container port stays 5432).
# 5433 is the default because 5432 is often occupied by a local PostgreSQL.
POSTGRES_PORT=5433
# Runtime role (NOSUPERUSER NOBYPASSRLS), used by the API + Worker via pg adapter.
DATABASE_URL=postgresql://changeradar_app:change-me-app@localhost:5433/changeradar?schema=public
# Migrator role, used by the Prisma CLI only (never at app startup).
DIRECT_DATABASE_URL=postgresql://changeradar_migrator:change-me-migrator@localhost:5433/changeradar?schema=public
# Bootstrap superuser (compose only): used once by `npm run db:roles`.
BOOTSTRAP_DATABASE_URL=postgresql://changeradar:changeradar@localhost:5433/changeradar?schema=public
MIGRATOR_PASSWORD=change-me-migrator
APP_PASSWORD=change-me-app

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (RustFS locally) ────────────────────────────────────────
# Server-side endpoint. Use http://storage:9000 when the API runs in compose.
S3_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint used only to sign presigned URLs.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=changeradar
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

# ── Authentication (Phase 3) ───────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=30
UPLOAD_TOKEN_SECRET=dev-only-change-me
MAX_UPLOAD_BYTES=10485760

# ── AI (Phase 9) ───────────────────────────────────────────────────────────
AI_PROVIDER=fake
AI_MODEL=fake-model
AI_API_KEY=
AI_MAX_CHANGES=50
AI_DAILY_LIMIT_PER_WORKSPACE=20
AI_GLOBAL_DAILY_LIMIT=200

# ── Worker (Phase 6) ───────────────────────────────────────────────────────
WORKER_CONCURRENCY_EXTRACTION=2
WORKER_CONCURRENCY_COMPARISON=2
WORKER_CONCURRENCY_AI=1

# ── Demo (Phase 11) ────────────────────────────────────────────────────────
DEMO_ENABLED=false
DEMO_RATE_LIMIT_PER_HOUR=10
DEMO_MAX_ACTIVE=50

# ── Observability / API ────────────────────────────────────────────────────
SWAGGER_ENABLED=true
LOG_LEVEL=info
# Number of trusted proxies in front of the API (0 locally).
TRUST_PROXY_HOPS=0

# ── Local Docker Compose only (not read by the app) ────────────────────────
POSTGRES_DB=changeradar
POSTGRES_USER=changeradar
POSTGRES_PASSWORD=changeradar
